# Portal login (the email/password you use to sign in to this app)
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=choose-a-strong-password

# Session cookie signing secret — set to a long random string
SESSION_SECRET=replace-with-a-long-random-string

# Skill India (NSDC) admin credentials used to fetch student data
NSDC_USERNAME=
NSDC_PASSWORD=

# Training partner ID (defaults to TP155158 if not set)
TP_ID=TP155158

# Port (Railway sets this automatically)
PORT=3000
